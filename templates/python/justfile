# =========================================================================
# python (FastAPI web service OR plain script) — dev → smoke-test recipes
# =========================================================================
# `variant` must match flake.nix — it picks how `just run` + `just test` behave.
# All deps come from pyproject.toml + uv.lock via uv2nix (the devShell venv IS
# the image's venv — no drift).
# =========================================================================
set shell := ["bash", "-c"]

variant := "fastapi"   # "fastapi" (web service) | "script" (runs and exits)
dep     := "pyapp"     # container name used by `just test`
port    := "8080"      # uvicorn listen port (fastapi variant)

# Run locally from the devShell venv (uvicorn for fastapi, python for script).
# The venv is built from pyproject.toml/uv.lock via uv2nix — no `uv pip install`.
run:
    #!/usr/bin/env bash
    cd app
    if [ "{{variant}}" = "script" ]; then
      python script.py
    else
      uvicorn main:app --reload --port {{port}}
    fi

# Build the Nix image (no Dockerfile, no docker).
build:
    nix build .#image --out-link result

# Local smoke test, variant-dependent: fastapi → run detached, curl /, expect
# 200; script → run attached and expect exit 0 (script images run and exit, so
# there is nothing to curl).
test: build
    #!/usr/bin/env bash
    set -euo pipefail
    command -v docker >/dev/null || { echo "test needs docker (virtualization.nix)"; exit 1; }
    img=$(docker load < "$(readlink -f result)" | sed -n 's/Loaded image: \(.*\)/\1/p')
    echo "loaded $img"
    if [ "{{variant}}" = "script" ]; then
      docker run --rm --tmpfs /tmp:mode=1777,uid=1000,gid=1000 "$img"
      echo "test: ok (script image exited 0)"
    else
      docker rm -f {{dep}}-test >/dev/null 2>&1 || true
      docker run -d --name {{dep}}-test --tmpfs /tmp:mode=1777,uid=1000,gid=1000 -p 18080:{{port}} "$img" >/dev/null
      sleep 2
      if curl -sf --max-time 5 http://localhost:18080/ >/dev/null; then
        echo "  HTTP 200 from /  OK"
      else
        echo "  FAIL no 200 - container logs:"; docker logs {{dep}}-test 2>&1 | tail -25; docker rm -f {{dep}}-test >/dev/null; exit 1
      fi
      docker rm -f {{dep}}-test >/dev/null
      echo "test: ok"
    fi

# Lint + type-check (the image build doesn't lint). ruff is strict; mypy is
# advisory until you add type hints / a mypy.ini. (For automatic-on-commit,
# wrap these in git-hooks.nix / pre-commit-hooks-nix.)
check:
    #!/usr/bin/env bash
    set -euo pipefail
    cd app
    ruff check .
    mypy . || echo "  mypy: advisory (add type hints / mypy.ini to enforce)"

# Drop into the devShell manually (direnv does this automatically on cd).
shell:
    nix develop
