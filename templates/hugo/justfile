# =========================================================================
# hugo static site — dev → smoke-test → publish recipes
# =========================================================================
# serve:  local dev server, live reload → http://localhost:1313
# build:  nix build .#image   (nginx OCI image serving the built site)
# test:   docker smoke — load the image, run it, curl / for a 200
# check:  hugo production build (catches broken layouts / frontmatter)
# cf:     publish the Nix-built site to Cloudflare Pages (public URL)
#   one-time:  wrangler login   (or: export CLOUDFLARE_API_TOKEN=…)
#              wrangler pages project create hugo-site --production-branch main
# =========================================================================
set shell := ["bash", "-c"]

dep        := "hugo-site"   # container name used by `just test`
port       := "8080"        # nginx listen port inside the image (non-root high port)
cf_project := "hugo-site"   # Cloudflare Pages project name (create once, see header)

# Build the Nix image (no Dockerfile, no docker).
build:
    nix build .#image --out-link result

# Local dev server (live reload) → http://localhost:1313. Source lives in ./site.
serve:
    cd site && hugo server -D --buildDrafts

# Local smoke: load the built image into docker, run it, curl /, expect 200.
test: build
    #!/usr/bin/env bash
    set -euo pipefail
    command -v docker >/dev/null || { echo "test needs docker (virtualization.nix)"; exit 1; }
    img=$(docker load < "$(readlink -f result)" | sed -n 's/Loaded image: \(.*\)/\1/p')
    echo "loaded $img"
    docker rm -f {{dep}}-test >/dev/null 2>&1 || true
    docker run -d --name {{dep}}-test --tmpfs /tmp:mode=1777,uid=1000,gid=1000 -p 18080:{{port}} "$img" >/dev/null
    sleep 2
    if curl -sf --max-time 5 http://localhost:18080/ >/dev/null; then
      echo "  HTTP 200 from /  OK"
    else
      echo "  FAIL no 200 - container logs:"; docker logs {{dep}}-test 2>&1 | tail -25; docker rm -f {{dep}}-test >/dev/null; exit 1
    fi
    docker rm -f {{dep}}-test >/dev/null
    echo "test: ok"

# Validate the site builds cleanly (catches broken layouts / frontmatter).
check:
    #!/usr/bin/env bash
    set -euo pipefail
    cd site
    hugo --gc --minify --destination /tmp/hugo-check >/dev/null && rm -rf /tmp/hugo-check && echo "hugo build OK"

# ── Cloudflare Pages (public URL) ───────────────────────────────────────────
# Builds the static site with Nix (packages.site) and uploads it directly —
# no Dockerfile, no Git-integration build; the same bytes the image serves.

# One-time setup (wrangler login + project create) is in the header above.
# Publish to PRODUCTION — creates the <project>.pages.dev URL, incremental on re-run.
cf:
    #!/usr/bin/env bash
    set -euo pipefail
    command -v wrangler >/dev/null 2>&1 || { echo "cf needs wrangler — run from the devShell (direnv allow)"; exit 1; }
    nix build .#site --out-link site-out
    echo "→ uploading ./site-out to Cloudflare Pages project '{{cf_project}}' (production)"
    wrangler pages deploy ./site-out --project-name {{cf_project}} --branch main

# Override the branch:  CF_BRANCH=feat-x just cf-preview
# Publish a PREVIEW build (a branch-specific preview URL, not production).
cf-preview:
    #!/usr/bin/env bash
    set -euo pipefail
    command -v wrangler >/dev/null 2>&1 || { echo "cf-preview needs wrangler — run from the devShell (direnv allow)"; exit 1; }
    nix build .#site --out-link site-out
    branch="${CF_BRANCH:-preview}"
    echo "→ uploading ./site-out to Cloudflare Pages project '{{cf_project}}' (preview branch: $branch)"
    wrangler pages deploy ./site-out --project-name {{cf_project}} --branch "$branch"

shell:
    nix develop
