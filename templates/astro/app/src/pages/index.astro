---
import '../styles/global.css';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>astro-app</title>
  </head>
  <body class="min-h-screen bg-zinc-950 text-zinc-100 antialiased">
    <main class="mx-auto flex min-h-screen max-w-3xl flex-col items-center justify-center gap-6 px-6">
      <h1 class="text-4xl font-bold tracking-tight text-sky-400">astro-app</h1>
      <p class="text-zinc-400">
        Astro + Tailwind v4 on the omni-nix pipeline — edit
        <code class="rounded bg-zinc-800 px-1.5 py-0.5 text-sky-300">src/pages/</code>
        and the site grows one file per route.
      </p>
      <p class="text-sm text-zinc-500">
        <code>just serve</code> dev · <code>just build &amp;&amp; just deploy</code> k3s ·
        <code>just cf</code> Cloudflare Pages
      </p>
    </main>
  </body>
</html>
